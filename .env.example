# Supabase/PostgreSQL connection strings (Prisma)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Resend API key for contact form emails — https://resend.com/api-keys
RESEND_API_KEY=""

# Auth.js (NextAuth v5) — generate with: npx auth secret (or openssl rand -base64 33)
AUTH_SECRET="a3399b2deba0730ab3b0bb1a5b9be548d4f27068adbc394f9a98947c065b3942"
# Required for any non-Vercel host (incl. local `next start`); Vercel
# auto-detects and trusts its own host, so this is a no-op there.
AUTH_TRUST_HOST="true"

# Seeds the first (and only) admin account — see prisma/seed.ts.
# Only used when running the seed script; not read at runtime after that.
ADMIN_EMAIL="mubashirejazkhan@gmail.com"
ADMIN_PASSWORD="123qwe456"
